            "sourceColumn": "IsNewTopic"
          },
          {
            "name": "Location",
            "dataType": "string",
            "sourceColumn": "Location"
          },
          {
            "name": "Full Name",
            "dataType": "string",
            "kind": "calculatedColumn",
            "expression": "RELATED(trainers[Trainer])"
          }
        ],
        "measures": [],
        "partitions": [
          {
            "name": "sessions",
            "mode": "import",
            "source": {
              "type": "m",
              "expression": "let\n    Source = Csv.Document(File.Contents(\"C:\\\\Users\\\\codex_pbi\\\\Documents\\\\GitHub\\\\PowerBi_Probeersel\\\\data\\\\sessions.csv\"), [Delimiter = \",\", Columns = 9, Encoding = 65001, QuoteStyle = QuoteStyle.None]),\n    PromotedHeaders = Table.PromoteHeaders(Source, [PromoteAllScalars = true])\nin\n    PromotedHeaders"
            }
          }
        ]
      },
      {
        "name": "workload_entries",
        "columns": [
          {
            "name": "EntryId",
            "dataType": "string",
            "sourceColumn": "EntryId"
          },
          {
            "name": "Date",
            "dataType": "dateTime",
            "sourceColumn": "Date"
          },
          {
            "name": "TrainerId",
            "dataType": "string",
            "sourceColumn": "TrainerId"
          },
          {
            "name": "CourseId",
            "dataType": "string",
            "sourceColumn": "CourseId"
          },
          {
            "name": "SessionId",
            "dataType": "string",
            "sourceColumn": "SessionId"
          },
          {
            "name": "Category",
            "dataType": "string",
            "sourceColumn": "Category"
          },
          {
            "name": "Hours",
            "dataType": "double",
            "sourceColumn": "Hours"
          },
          {
            "name": "Source",
            "dataType": "string",
            "sourceColumn": "Source"
          },
          {
            "name": "Description",
            "dataType": "string",
            "sourceColumn": "Description"
          }
        ],
        "measures": [
          {
            "name": "Total Workload Hours",
            "expression": "SUM ( workload_entries[Hours] )"
          },
          {
            "name": "Contact Hours",
            "expression": "CALCULATE (\n    [Total Workload Hours],\n    workload_entries[Category] = \"Lesgeven\"\n)"
          },
          {
            "name": "Preparation Hours",
            "expression": "CALCULATE (\n    [Total Workload Hours],\n    workload_entries[Category] = \"Voorbereiding\"\n)"
          },
          {
            "name": "Aftercare Hours",
            "expression": "CALCULATE (\n    [Total Workload Hours],\n    workload_entries[Category] = \"Nazorg\"\n)"
          },
          {
            "name": "Administration Hours",
            "expression": "CALCULATE (\n    [Total Workload Hours],\n    workload_entries[Category] = \"Administratie\"\n)"
          },
          {
            "name": "Innovation Hours",
            "expression": "CALCULATE (\n    [Total Workload Hours],\n    workload_entries[Category] = \"AI/innovatie\"\n)"
          },
          {
            "name": "Prep Contact Ratio",
            "expression": "DIVIDE ( [Preparation Hours], [Contact Hours] )"
          },
          {
            "name": "Invisible Work Hours",
            "expression": "[Total Workload Hours] - [Contact Hours]"
          },
          {
            "name": "Visibility Gap %",
            "expression": "DIVIDE ( [Invisible Work Hours], [Total Workload Hours] )"
          },
          {
            "name": "Average Evaluation Score",
            "expression": "DIVIDE (\n    SUMX ( evaluation_responses, evaluation_responses[AverageScore] * evaluation_responses[ResponseCount] ),\n    SUM ( evaluation_responses[ResponseCount] )\n)"
          },
          {
            "name": "Total Responses",
            "expression": "SUM ( evaluation_responses[ResponseCount] )"
          },
          {
            "name": "New Topic Sessions",
            "expression": "CALCULATE (\n    COUNTROWS ( sessions ),\n    sessions[IsNewTopic] = TRUE ()\n)"
          },
          {
            "name": "Workload Score",
            "expression": "VAR ComplexityLoad =\n    AVERAGE ( courses[ComplexityScore] )\nVAR PrepRatio =\n    [Prep Contact Ratio]\nVAR Aftercare =\n    [Aftercare Hours]\nRETURN\n    [Total Workload Hours]\n        + ( ComplexityLoad * 2 )\n        + ( PrepRatio * 5 )\n        + ( Aftercare * 0.5 )"
          },
          {
            "name": "Fairness Flag",
            "expression": "VAR Gap = [Visibility Gap %]\nVAR Score = [Average Evaluation Score]\nVAR PrepRatio = [Prep Contact Ratio]\nRETURN\n    SWITCH (\n        TRUE (),\n        Gap >= 0.55, \"Hoge werkdruk, lage zichtbaarheid\",\n        PrepRatio >= 0.8 && Score < 4.0, \"Complex vak vraagt ondersteuning\",\n        [Aftercare Hours] >= 8, \"Veel nazorg na sessie\",\n        [New Topic Sessions] >= 2, \"Veel nieuwe onderwerpen\",\n        \"Geen opvallend signaal\"\n    )"
          }
        ],
        "partitions": [
          {
            "name": "workload_entries",
            "mode": "import",
            "source": {
              "type": "m",
              "expression": "let\n    Source = Csv.Document(File.Contents(\"C:\\\\Users\\\\codex_pbi\\\\Documents\\\\GitHub\\\\PowerBi_Probeersel\\\\data\\\\workload_entries.csv\"), [Delimiter = \",\", Columns = 9, Encoding = 65001, QuoteStyle = QuoteStyle.None]),\n    PromotedHeaders = Table.PromoteHeaders(Source, [PromoteAllScalars = true])\nin\n    PromotedHeaders"
            }
          }
        ]
